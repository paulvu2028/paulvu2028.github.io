---
import { profile } from "../data/profile";
import { experience } from "../data/experience";

const current = experience[0];
---

<section id="top" class="relative overflow-hidden border-b border-line">
  <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
  <div
    class="container-site relative flex min-h-[calc(100svh-4rem)] flex-col justify-center py-24 md:py-32"
  >
    <p class="mb-6 font-mono text-xs text-accent md:text-sm">
      <span class="text-muted">01</span> / {profile.location}
    </p>
    <h1
      class="max-w-3xl font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl"
    >
      {profile.name}
    </h1>
    <p class="mt-5 font-display text-xl font-medium text-accent sm:text-2xl md:text-3xl">
      {profile.role}
    </p>
    <p class="mt-6 max-w-xl font-mono text-xs leading-relaxed text-muted sm:text-sm">
      {profile.heroSubline}
    </p>
    <p class="mt-8 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
      {profile.heroBlurb}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="#projects" class="btn btn-primary">View projects</a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
      <a
        href="/resume"
        class="font-mono text-sm text-muted underline decoration-dotted underline-offset-4 transition-colors hover:text-accent"
      >
        Resume
      </a>
    </div>
    <p class="mt-14 font-mono text-xs text-muted">
      <span class="text-accent">Currently</span>
      {current.role} at {current.org}
    </p>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      radial-gradient(42rem 24rem at 70% 10%, rgb(52 211 153 / 0.07), transparent 70%),
      linear-gradient(to right, rgb(52 211 153 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(52 211 153 / 0.045) 1px, transparent 1px);
    background-size:
      100% 100%,
      44px 44px,
      44px 44px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 0%, black 35%, transparent 78%);
  }
</style>
