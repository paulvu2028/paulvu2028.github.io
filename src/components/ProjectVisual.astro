---
interface Props {
  variant: "terminal" | "checker" | "plain";
  title: string;
}

const { variant, title } = Astro.props;

const labels = {
  terminal: "Stylized terminal chat mockup for Grand Line Navigator",
  checker: "Checkered flag motif for Apex Season",
  plain: `Decorative panel for ${title}`,
} as const;

const ariaLabel = labels[variant];
---

<figure class="visual h-full w-full" role="img" aria-label={ariaLabel}>
  {
    variant === "terminal" && (
      <div class="flex h-full w-full flex-col bg-surface-2 font-mono">
        <div class="flex items-center gap-2 border-b border-line bg-surface px-4 py-2.5 text-[10px] text-muted sm:text-xs">
          <span class="dot bg-muted/60" aria-hidden="true" />
          <span class="dot bg-muted/60" aria-hidden="true" />
          <span class="dot bg-accent/80" aria-hidden="true" />
          <span class="ml-2">glnavigator - chat</span>
        </div>
        <div class="flex flex-1 flex-col justify-center gap-2.5 px-5 py-5 text-[10px] leading-relaxed sm:gap-3 sm:text-xs">
          <p>
            <span class="text-accent">$</span>
            <span class="text-ink"> glnavigator chat</span>
          </p>
          <p class="text-ink">
            <span class="text-accent">&gt;</span> how do these two cards interact?
          </p>
          <p class="text-muted">
            search <span class="text-ink">SQLite FTS5 + vector embeddings</span>
          </p>
          <p class="text-muted">
            fuse <span class="text-ink">reciprocal rank fusion</span>
          </p>
          <p class="text-ink">
            grounded answer, cited <span class="cite">OP-04-109</span>
            <span class="cursor" aria-hidden="true" />
          </p>
        </div>
      </div>
    )
  }
  {
    variant === "checker" && (
      <div class="flex h-full w-full flex-col bg-surface-2">
        <div class="flex items-center justify-between px-4 py-2.5 font-mono text-[10px] text-muted sm:text-xs">
          <span>apex-season</span>
          <span>godot 4</span>
        </div>
        <div class="relative flex flex-1 items-center justify-center">
          <div class="checker-band absolute inset-x-0 top-1/2 h-10 -translate-y-1/2" aria-hidden="true" />
          <p class="relative bg-bg/85 px-5 py-1.5 font-display text-lg font-bold tracking-[0.3em] text-ink sm:text-xl">
            FINISH
          </p>
        </div>
        <div class="border-t border-line bg-surface px-4 py-2.5 font-mono text-[10px] text-muted sm:text-xs">
          raycast car physics / procedural track / 3 AI opponents
        </div>
      </div>
    )
  }
  {
    variant === "plain" && (
      <div class="flex h-full w-full items-center justify-center bg-surface-2">
        <p class="font-display text-2xl font-bold tracking-tight text-muted">{title}</p>
      </div>
    )
  }
</figure>

<style>
  .visual {
    display: block;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
  }

  .cite {
    border: 1px solid var(--color-accent);
    border-radius: 0.375rem;
    color: var(--color-accent);
    padding: 0.1rem 0.4rem;
    white-space: nowrap;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.4em;
    vertical-align: text-bottom;
    background-color: var(--color-accent);
    animation: blink 1.1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  .checker-band {
    background-image: repeating-conic-gradient(
      var(--color-accent) 0% 25%,
      transparent 0% 50%
    );
    background-size: 1.4rem 1.4rem;
    border-block: 1px solid var(--color-line);
  }
</style>
