---
import { profile } from "../data/profile";

const year = new Date().getFullYear();

const socials = [
  { label: "GitHub", href: profile.github },
  { label: "LinkedIn", href: profile.linkedin },
  { label: "Email", href: `mailto:${profile.email}` },
];
---

<footer class="border-t border-line print:hidden">
  <div
    class="container-site flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-col gap-1">
      <p class="font-display text-sm font-semibold">
        &copy; {year} {profile.name}
      </p>
      <p class="font-mono text-xs text-muted">{profile.location}</p>
    </div>
    <ul class="flex items-center gap-5">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="font-mono text-xs text-muted transition-colors hover:text-accent"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="font-mono text-xs text-muted sm:text-right">
      Built with <a
        href="https://astro.build"
        class="text-accent underline decoration-dotted underline-offset-4 hover:text-accent-strong"
        rel="noopener noreferrer">Astro</a
      >
    </p>
  </div>
</footer>
