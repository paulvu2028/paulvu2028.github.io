---
import { testimonials } from "../data/testimonials";
import SectionHeading from "./SectionHeading.astro";
---

<section id="testimonials" class="container-site py-16 md:py-24">
  <SectionHeading number="07" title="Testimonials" />
  <ul class="grid gap-5 md:grid-cols-3">
    {
      testimonials.map((testimonial) => (
        <li>
          <figure class="flex h-full flex-col rounded-lg border border-line bg-surface p-6 transition-colors hover:border-accent">
            <blockquote class="flex-1">
              <p class="mb-4 font-display text-4xl leading-none text-accent" aria-hidden="true">
                &ldquo;
              </p>
              <p class="text-sm leading-relaxed text-ink">{testimonial.quote}</p>
            </blockquote>
            <figcaption class="mt-6 border-t border-line pt-4">
              <p class="font-display text-sm font-semibold">{testimonial.name}</p>
              <p class="mt-0.5 font-mono text-xs text-muted">{testimonial.role}</p>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
