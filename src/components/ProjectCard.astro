---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const hasImage = (project.images?.length ?? 0) > 0;
const cardImage = hasImage ? project!.images![0] : undefined;

const visualVariant: "terminal" | "checker" | "plain" =
  project.slug === "glnavigator"
    ? "terminal"
    : project.slug === "apex-season"
      ? "checker"
      : "plain";
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-accent"
>
  <div class="relative aspect-video overflow-hidden border-b border-line">
    {
      cardImage ? (
        <Image
          src={cardImage}
          alt={`${project.title} screenshot`}
          width={800}
          height={450}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
      ) : (
        <ProjectVisual variant={visualVariant} title={project.title} />
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span
        class={`inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider ${
          project.status === "Active" ? "text-accent" : "text-muted"
        }`}
      >
        <span
          class={`h-1.5 w-1.5 rounded-full ${project.status === "Active" ? "bg-accent" : "bg-muted"}`}
          aria-hidden="true"></span>
        {project.status}
      </span>
      <ul class="flex flex-wrap gap-1.5">
        {project.tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
    </div>
    <h3 class="font-display text-xl font-semibold tracking-tight">
      <a
        href={`/projects/${project.slug}/`}
        class="transition-colors after:absolute after:inset-0 after:rounded-xl group-hover:text-accent"
      >
        {project.title}
      </a>
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-muted">{project.summary}</p>
    <p class="mt-5 font-mono text-xs text-accent opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      View project -&gt;
    </p>
  </div>
</article>
