---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";
import ProjectVisual from "../../components/ProjectVisual.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const detailImages = project.images?.slice(1) ?? [];
const hasCardArt = (project.images?.length ?? 0) === 0;

const visualVariant: "terminal" | "checker" | "plain" =
  project.slug === "glnavigator"
    ? "terminal"
    : project.slug === "apex-season"
      ? "checker"
      : "plain";

const sorted = [...projects].sort((a, b) => a.sort - b.sort);
const currentIndex = sorted.findIndex((item) => item.slug === project.slug);
const prev = sorted[currentIndex - 1];
const next = sorted[currentIndex + 1];
---

<BaseLayout title={`${project.title} - Paul Vu`} description={project.summary}>
  <article class="container-site py-16 md:py-24">
    <p class="mb-8 font-mono text-xs text-muted">
      <a href="/projects/" class="transition-colors hover:text-accent">All projects</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-accent">{project.title}</span>
    </p>

    <header class="mb-10 max-w-3xl md:mb-12">
      <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span
          class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs uppercase tracking-wider ${
            project.status === "Active"
              ? "border-accent/40 bg-accent/10 text-accent"
              : "border-line bg-surface text-muted"
          }`}
        >
          <span
            class={`h-1.5 w-1.5 rounded-full ${project.status === "Active" ? "bg-accent" : "bg-muted"}`}
            aria-hidden="true"></span>
          {project.status}
        </span>
        <ul class="flex flex-wrap gap-1.5">
          {
            project.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))
          }
        </ul>
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
        {project.title}
      </h1>
      <p class="mt-5 text-base leading-relaxed text-ink md:text-lg">{project.summary}</p>
    </header>

    {
      hasCardArt && (
        <div class="mb-12 overflow-hidden rounded-xl border border-line">
          <div class="aspect-video">
            <ProjectVisual variant={visualVariant} title={project.title} />
          </div>
        </div>
      )
    }

    <div class="max-w-3xl space-y-5 text-base leading-relaxed text-muted md:text-lg">
      {project.detail.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      detailImages.length > 0 && (
        <ul class="mt-12 grid gap-4 sm:grid-cols-2">
          {detailImages.map((image, index) => (
            <li class="overflow-hidden rounded-xl border border-line bg-surface">
              <Image
                src={image}
                alt={`Screenshot ${index + 1} of ${project.title}`}
                width={800}
                height={500}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      )
    }

    {
      project.links.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-muted">Links</h2>
          <ul class="flex flex-wrap gap-4">
            {project.links.map((link, index) => (
              <li>
                <a
                  href={link.url}
                  rel="noopener noreferrer"
                  class={index === 0 ? "btn btn-primary" : "btn btn-ghost"}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <nav
      class="mt-16 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:justify-between"
      aria-label="Project navigation"
    >
      {
        prev && (
          <a
            href={`/projects/${prev.slug}/`}
            class="group max-w-sm rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent"
          >
            <p class="mb-1 font-mono text-xs text-muted">Previous</p>
            <p class="font-display text-sm font-semibold transition-colors group-hover:text-accent">
              {prev.title}
            </p>
          </a>
        )
      }
      {
        next && (
          <a
            href={`/projects/${next.slug}/`}
            class="group max-w-sm rounded-lg border border-line bg-surface p-4 transition-colors hover:border-accent sm:text-right sm:ml-auto"
          >
            <p class="mb-1 font-mono text-xs text-muted">Next</p>
            <p class="font-display text-sm font-semibold transition-colors group-hover:text-accent">
              {next.title}
            </p>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
